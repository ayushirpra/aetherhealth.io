# Server Environment Variables — AetherHealth
# Copy to .env and fill in real values. Never commit .env.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB Atlas ─────────────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aetherhealth?retryWrites=true&w=majority

# ── JWT (added Phase 2) ───────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── Encryption (added Phase 4) ────────────────────────────────────────────────
ENCRYPTION_KEY=replace_with_32_byte_hex_key

# ── Pinata / IPFS (added Phase 4) ─────────────────────────────────────────────
PINATA_API_KEY=
PINATA_SECRET_API_KEY=
PINATA_JWT=

# ── Gemini API (added Phase 5) ────────────────────────────────────────────────
GEMINI_API_KEY=

# ── Blockchain / Polygon Amoy (added Phase 7) ─────────────────────────────────
RPC_URL=https://rpc-amoy.polygon.technology
PRIVATE_KEY=replace_with_deployer_wallet_private_key
CONTRACT_ADDRESS=
